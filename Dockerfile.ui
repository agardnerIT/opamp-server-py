FROM python:3.12-slim

WORKDIR /app

# The UI imports server helpers that create their SQLite stores at import. The
# real data volume is mounted read-only, so keep those stores in a throwaway
# writable directory. The UI reads fleet data from the API, not this database.
ENV DATA_DIR=/tmp/opamp-ui-data

# Install dependencies
COPY requirements.txt requirements-ui.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-ui.txt

# Copy application code
COPY ui/ ./ui/
COPY server/ ./server/
COPY proto/ ./proto/
COPY policies/ ./policies/
COPY data/ ./data/
COPY collector/ ./collector/
# Streamlit reads ./.streamlit/config.toml relative to the working directory, so
# without this the XSRF/CORS posture in that file silently does not apply inside the
# container (#105).
COPY .streamlit/ ./.streamlit/
COPY .env.sample .

# Expose Streamlit port
EXPOSE 8501

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" || exit 1

# Run Streamlit
CMD ["streamlit", "run", "ui/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]

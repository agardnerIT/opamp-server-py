{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opamp-updates",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "UPDATES_KV",
      "id": "4566023a0369459bb3b36ad64d19c154"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://opamp-updates.tame-lamp8409.workers.dev",
    "RESEND_SEGMENT_ID": "6d1a7513-297e-41e1-bb8c-846f6502ee2b",
    "RESEND_FROM": "opamp-server-py <updates@opampserver.agardner.net>",
    "RESEND_REPLY_TO": "privacy@agardner.net",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFxULtZUOn0fc_zq",
    "PRIVACY_URL": "",
    "PRIVACY_CONTACT": "privacy@agardner.net",
    "DASHBOARD_URL": "",
    "REPO_URL": "https://github.com/agardnerIT/opamp-server-py"
  }
}

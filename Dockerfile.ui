# The OpAMP Console (web/) — a static React bundle served by nginx.
#
# Replaces the Streamlit image at the new-ui-plans stage-10 cutover. Two stages:
# Node builds `web/dist`, nginx serves it and proxies /api to the server service
# (see docker/ui.nginx.conf). Nothing from the Python tree is copied in: the
# console reads the server over HTTP, exactly like any other client, so it has no
# database, no DATA_DIR, and no configuration of its own.

FROM node:22-alpine AS build

WORKDIR /app/web

# Dependencies first, so a source-only change reuses this layer. `npm ci` is the
# gate that makes the committed lockfile authoritative — an image must not be
# built from a range that resolved differently today than it did yesterday.
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY web/ ./

# tsc -b (strict) runs inside the build: a type error is a failed image, not a
# bundle. The API types in src/api/schema.d.ts are committed (npm run gen-api),
# so the build needs no live server.
RUN npm run build


FROM nginx:alpine

# Unprivileged-by-default is not available in nginx:alpine without a rebuilt
# image; the container publishes one loopback port and holds no data, which is
# the smaller risk. The server's port is the one that matters (#96).
COPY docker/ui.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html

# nginx:alpine listens on 80 and logs to stdout/stderr (docker logs).
EXPOSE 80

# busybox wget: the request has to succeed AND be the shell, so a half-broken
# SPA fallback shows up as an unhealthy container rather than a blank page.
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/index.html || exit 1

CMD ["nginx", "-g", "daemon off;"]

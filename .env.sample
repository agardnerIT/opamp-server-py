# Server
SERVER_HTTP_SCHEME=http
SERVER_ADDRESS=localhost
SERVER_PORT=4320

# Telemetry - Collectors send metrics here via OTLP (http/protobuf)
TELEMETRY_ENABLED=true
TELEMETRY_PORT=4320

# OPA (Open Policy Agent)
OPA_URL=http://localhost:8181
OPA_ENABLED=false
POLICIES_DIR=policies/tags

# Data
DATA_DIR=data

# Admin password for sensitive actions (leave empty to disable)
ADMIN_PASSWORD=changeme

# Agent
AGENT_TIMEOUT_SECONDS=60
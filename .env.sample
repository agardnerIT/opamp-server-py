# Server
SERVER_HTTP_SCHEME=http
SERVER_ADDRESS=localhost
SERVER_PORT=4320

# Telemetry - Collectors send metrics here via OTLP (http/protobuf)
TELEMETRY_ENABLED=true
TELEMETRY_PORT=4320

# OPA (Open Policy Agent)
OPA_URL=http://localhost:8181
OPA_ENABLED=false
POLICIES_DIR=policies/tags

# Data
DATA_DIR=data

# --- Admin auth (#95) --------------------------------------------------------
# One credential is required for anything that mutates the fleet. With none of
# these set the server runs in READ-ONLY mode: reads are open, every privileged
# write answers 403, and config push refuses to start (#96).
#
# Preferred: named principals with roles, created with
#   opampctl auth principals create <name> --role operator|approver|admin
# (stored scrypt-hashed in $DATA_DIR/opamp.db; `approver` != `operator` is what
# makes two-phase config push an approval rather than a formality).
#
# The shared password below still works as a single anonymous `admin` principal —
# deprecated, because you cannot give two people different rights with it, and
# you cannot revoke one person without changing everyone's password.
#   1. Set it here, or
#   2. mount it with ADMIN_PASSWORD_FILE=/run/secrets/admin_password, or
#   3. leave both empty and let the server generate one (see next block).
# Never leave a placeholder: "changeme" is tried first by every scanner.
ADMIN_PASSWORD=
# Read the admin password from a file (secret mount) instead of the environment.
ADMIN_PASSWORD_FILE=
# Generate a random admin password on first start, print it once, and store it in
# $DATA_DIR/admin_password (0600) for subsequent starts. docker-compose.yml
# enables this by default; set false to stay in read-only mode.
OPAMP_ADMIN_AUTOGENERATE_PASSWORD=false

# CORS: comma-separated list of allowed origins (default * = allow all)
CORS_ORIGINS=*

# Agent
# Silence before an agent is dropped. The floor only: an agent that reports more
# slowly than this (a collector with a long `polling_interval`) is kept for
# AGENT_TIMEOUT_INTERVAL_MARGIN x its own observed interval instead (#69).
AGENT_TIMEOUT_SECONDS=180
# Multiplier on the learned reporting interval. A dead agent is removed after
# ~this many missed polls; 3 tolerates one lost report without flapping.
AGENT_TIMEOUT_INTERVAL_MARGIN=3
# Budget for an agent that has not yet reported twice (no interval known yet):
# "slow poller" and "died on startup" look identical, so this window is generous.
AGENT_FIRST_CONTACT_SECONDS=900
# OpAMP WebSocket transport (#86). false = HTTP-only, the default.
OPAMP_WS_ENABLED=false
# Max OpAMP message size in bytes, header included (WebSocket receive + send).
OPAMP_MAX_MESSAGE_BYTES=67108864
# Per-connection outbound queue depth; oldest message is dropped when full.
OPAMP_WS_OUTBOUND_QUEUE=32

# --- Config push (#96) -------------------------------------------------------
# Remote config push is opt-in and fails closed: read-only features work in any
# posture, but pushing config requires admin auth + agent auth + TLS, or the
# server refuses to start. Every value below is documented in README →
# "Before you expose this server".
#
# Master switch. false (default) = push routes return 404 and the server never
# advertises OffersRemoteConfig nor sends a remote_config field.
OPAMP_CONFIG_PUSH_ENABLED=false
# LOCAL DEVELOPMENT ONLY. Starts the server with push enabled on an insecure
# posture, prints a red warning, reports insecure: true in /health, and shows a
# permanent banner in the UI. Anyone who can reach the server can rewrite your
# fleet's config while this is on.
OPAMP_ALLOW_INSECURE_CONFIG_PUSH=false
# How agents authenticate on the OpAMP channel (#94): off | token | mtls.
#   off   - default. Any client that can reach the port can claim any instance_uid;
#           the server logs a startup warning, and config push refuses to start.
#   token - each agent sends `Authorization: Bearer <token>`. Mint one per agent
#           with `opampctl --password ... agents token create <agent-id>` and paste
#           the returned collector_snippet into the collector config
#           (extensions.opamp.server.http.headers). Rotation is zero-downtime;
#           revocation blocks delivery but keeps the agent's state.
#   mtls  - NOT enforced by this build (client certs are terminated by your proxy),
#           so it is reported in /health but does not open the config-push gate.
OPAMP_AGENT_AUTH=off
# Public base URL agents and browsers use (https:// or wss:// counts as TLS).
# Protected TLS termination from a proxy: set PUBLIC_URL=https://<host>.
PUBLIC_URL=
# Set true when a TLS terminator you control sits in front of the server
# (docker/nginx.conf, docker/Caddyfile). Assertion only — keep the server on
# loopback so nothing can bypass the proxy.
TLS_TERMINATED_UPSTREAM=false
# Audit log for privileged actions (#97): append-only, hash-chained rows in
# data/opamp.db recording who did what. ON by default — an audit log an operator has
# to remember to switch on is off during every incident that matters. Turning it off
# makes privileged writes refuse (fail closed): a change nobody can record is a
# change nobody can review.
OPAMP_AUDIT_ENABLED=true
# Entries older than this are pruned (at most hourly) with an `audit.checkpoint` row
# recording the hash it cut to, so the chain stays verifiable. 0 = keep forever.
AUDIT_RETENTION_DAYS=365

# --- Config data and secrets (#98) -------------------------------------------
# Config bodies (desired and reported) contain exporter credentials. They are
# encrypted at rest with AES-256-GCM, one key, bound to the row they belong to.
# Generate a key:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Losing the key loses DESIRED config, not the fleet: agents keep running their
# last applied config and the server can rebuild from what they report.
CONFIG_AT_REST_KEY=
# Rotation: set the new key above, put the old one here, run
#   opampctl config rotate-key --db data/opamp.db
# then clear this. Rows sealed with a key you no longer supply fail closed with a
# clear error (they are never silently replaced with NULL).
CONFIG_AT_REST_KEY_PREVIOUS=
# LOCAL DEVELOPMENT ONLY. Store config bodies in plaintext and let config push
# start without a key. Reported as config_at_rest: plaintext in /health.
OPAMP_ALLOW_PLAINTEXT_CONFIG_STORAGE=false
# Max size of one pushed config map, in bytes. A collector config is kilobytes.
CONFIG_MAX_BYTES=1048576

# --- Push delivery over WebSocket (#102) -------------------------------------
# Delivery is desired state, not a command: the config is stored once and sent when
# the agent's reported hash differs. A live WebSocket connection lets the server
# skip the wait for the agent's next report; HTTP-only agents get it on that report
# (status "queued"). These settings bound the push path so a 100-agent rollout
# cannot starve heartbeats sharing the same socket.
#
# Config frames per second allowed on ONE connection. Over the limit the frame is
# dropped-not-delivered ("throttled") and reconciliation sends it on the next
# report — a rollout is never blocked waiting for one slow collector.
CONFIG_PUSH_RATE_PER_SECOND=20
# Burst allowance per connection, i.e. how many config frames it accepts back to
# back before the rate applies. Must comfortably exceed a healthy batch size.
CONFIG_PUSH_BURST=20
# Global cap on config frames queued but not yet written. Protects server memory
# when many connections are slow; over the cap pushes degrade to "queued".
CONFIG_PUSH_MAX_CONCURRENT=50
# How long a route waits for the event loop to accept a push onto a live connection
# before answering "queued" (the poll fallback still delivers it).
CONFIG_PUSH_WAIT_SECONDS=2
# Superseded config revisions keep their hash, author and timestamps but lose the
# body after this many days. The current revision is never pruned. 0 = keep forever.
CONFIG_RETENTION_DAYS=30

# --- Config validation (#100) ------------------------------------------------
# The server cannot prove a config will not crash a collector, but it can refuse
# the recognisable mistakes. These are the bounds of the parse guard: an alias
# budget, a nesting budget, and an *expanded* node ceiling (the alias-bomb guard —
# a small document that would become a billion nodes when expanded).
CONFIG_MAX_ALIASES=10000
CONFIG_MAX_DEPTH=50
CONFIG_MAX_NODES=100000
# Egress allowlist. When set, an exporter endpoint whose host is not listed is a
# warning (never a block: an exporter is a legitimate egress path, so the operator
# decides). Comma-separated hosts, e.g. backend.example.com,otlp.internal:4318
CONFIG_ALLOWED_EXPORTER_HOSTS=
# Endpoints a pushed config may point the `opamp` extension at. Defaults to this
# server's PUBLIC_URL plus OPAMP_SERVER_ENDPOINT/OPAMP_WS_ENDPOINT/OPAMP_HTTP_ENDPOINT.
# A config that moves the control channel is refused unless the request explicitly
# allows it AND an approver confirms. Comma-separated extra endpoints go here.
CONFIG_ALLOWED_OPAMP_ENDPOINTS=

# --- Config delivery (#99) ---------------------------------------------------
# Frames per assignment before the server stops re-pushing an agent that never
# acknowledges and marks it `unconfirmed` instead of looping forever.
CONFIG_MAX_DELIVERY_ATTEMPTS=5
# How long a supervisor gets to apply a pushed config and report back before a
# repeated "different hash" report is treated as an auto-revert (T9). Too small
# poisons healthy rollouts; the supervisor needs a restart (SIGHUP) to apply.
CONFIG_REVERT_GRACE_SECONDS=120

# Admin sessions (#95): `POST /auth/session` returns a bearer token so a person
# is not re-sending a password on every click. Both limits apply: absolute TTL
# and idle timeout. Revoke with `DELETE /auth/session` (self) or
# `DELETE /auth/sessions/{id}` (admin).
ADMIN_SESSION_TTL_SECONDS=3600
ADMIN_SESSION_IDLE_SECONDS=900
# Failed-login lockout, per (name, client IP): the first N failures are free, then
# exponential backoff 30s -> 2x -> 4x ... capped, answered with 429 + Retry-After.
# Counters live in memory (a brute-force attempt must not become a DB write per
# guess) and are per worker.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_BACKOFF_SECONDS=30
ADMIN_LOGIN_MAX_BACKOFF_SECONDS=900
# Behind docker/nginx.conf or docker/Caddyfile: trust X-Forwarded-For for the
# lockout key and the audit trail. Leave false when the server is directly
# reachable — a header any client can forge is not an identity, and trusting it
# collapses every client into one lockout bucket.
TRUST_PROXY_HEADERS=false

# --- MCP server (#94/#106) ---------------------------------------------------
# Read by `python -m mcp_server`, not by the API server. Privileged write tools
# (currently credential minting: create_agent_token/revoke_agent_token) are
# ABSENT unless this is true — an AI client that cannot see a tool will not use it.
OPAMP_MCP_ALLOW_WRITES=false

# --- Observability (#108) ----------------------------------------------------
# Log encoding. Empty = json when stderr is not a TTY (containers, CI, systemd),
# text for a local terminal. LOG_FORMAT=json makes every line one JSON object with
# `event`, `request_id`, `agent_id`, `trace_id` where relevant.
LOG_FORMAT=
# TRACE | DEBUG | INFO | SUCCESS | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Optional rotated file sink (containers rarely have a log shipper). Empty = off.
LOG_FILE=
LOG_FILE_ROTATION=10 MB
LOG_FILE_RETENTION=7 days
# OTLP tracing, off by default. Requires `pip install -e ".[observability]"`.
# The exporter reads the standard OTEL_EXPORTER_OTLP_ENDPOINT variable.
OPAMP_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=opamp-server
# parentbased_always_on | always_on | always_off | traceidratio
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=
